# --- Data: never commit the raw archive or the extracted dataset ---
data/*
!data/README.md

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Generated outputs ---
# report/figures/*.png is deliberately NOT ignored: the four figures the
# LaTeX report includes are ~290 KB in total, and committing them lets
# anyone build report/data_report.tex from a bare clone, without the
# 142 MB Kaggle download. `python -m src.run_all` refreshes them.
report/figures/*.pdf
*.log
*.aux
*.out
*.synctex.gz
results/
*.csv.gz

# Everything in reports/ is regenerated by `python -m src.run_all`.
reports/*

# --- OS / editor cruft ---
.DS_Store
.idea/
.vscode/
.pytest_cache/